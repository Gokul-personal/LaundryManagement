@model List<LaundryMVC.Models.Register>
@{
    ViewData["Title"] = "Customer List";
    int serial = 1;
}
<!DOCTYPE html>
<html>
<head>
    <title>Customer List</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { box-sizing:border-box; margin:0; padding:0; }
        body {
            min-height:100vh; font-family:'Segoe UI',sans-serif;
            background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);
            position:relative; overflow-x:hidden;
        }
        body::before {
            content:''; position:fixed; width:500px; height:500px; border-radius:50%;
            background:radial-gradient(circle,rgba(99,102,241,0.25),transparent 70%);
            top:-100px; left:-100px; pointer-events:none;
        }
        body::after {
            content:''; position:fixed; width:400px; height:400px; border-radius:50%;
            background:radial-gradient(circle,rgba(16,185,129,0.15),transparent 70%);
            bottom:-80px; right:-80px; pointer-events:none;
        }
        nav {
            display:flex; align-items:center; justify-content:space-between;
            padding:0 32px; height:64px;
            background:rgba(255,255,255,0.05); backdrop-filter:blur(12px);
            border-bottom:1px solid rgba(255,255,255,0.1); position:relative; z-index:10;
        }
        .brand { display:flex; align-items:center; gap:10px; font-size:17px; font-weight:600; color:#fff; text-decoration:none; }
        .brand-dot {
            width:32px; height:32px; border-radius:10px;
            background:linear-gradient(135deg,#6366f1,#8b5cf6);
            display:flex; align-items:center; justify-content:center;
            box-shadow:0 0 16px rgba(139,92,246,0.6); font-size:16px; color:white;
        }
        .nav-badge { font-size:10px; padding:3px 10px; border-radius:12px; background:rgba(99,102,241,0.2); color:#a5b4fc; border:1px solid rgba(99,102,241,0.3); }
        .container { max-width:900px; margin:0 auto; padding:36px 24px; position:relative; z-index:2; }
        .page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
        .page-head h2 { font-size:22px; font-weight:600; color:#fff; }
        .page-head p { font-size:13px; color:rgba(255,255,255,0.45); margin-top:3px; }
        .back-btn {
            display:flex; align-items:center; gap:6px;
            background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.75);
            border:1px solid rgba(255,255,255,0.15); border-radius:10px;
            padding:8px 16px; font-size:13px; text-decoration:none; transition:background 0.15s;
        }
        .back-btn:hover { background:rgba(255,255,255,0.13); }
        .glass-card {
            background:rgba(255,255,255,0.06);
            backdrop-filter:blur(16px);
            border-radius:20px;
            border:1px solid rgba(255,255,255,0.12);
            padding:24px;
            box-shadow:0 8px 40px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.1);
            overflow-x:auto;
        }
        table { width:100%; border-collapse:collapse; }
        thead tr { border-bottom:1px solid rgba(255,255,255,0.1); }
        thead th { padding:12px 16px; font-size:11px; font-weight:600; color:rgba(255,255,255,0.5); text-transform:uppercase; letter-spacing:0.5px; }
        tbody tr { border-bottom:1px solid rgba(255,255,255,0.06); transition:background 0.15s; }
        tbody tr:hover { background:rgba(255,255,255,0.04); }
        tbody tr:last-child { border-bottom:none; }
        td { padding:13px 16px; font-size:13px; color:rgba(255,255,255,0.85); vertical-align:middle; }
        .avatar {
            width:34px; height:34px; border-radius:50%;
            background:rgba(99,102,241,0.3); border:1px solid rgba(99,102,241,0.4);
            display:inline-flex; align-items:center; justify-content:center;
            font-size:13px; font-weight:600; color:#a5b4fc; margin-right:10px;
        }
        .name-cell { display:flex; align-items:center; }
        .role-pill { display:inline-block; font-size:11px; font-weight:600; padding:4px 12px; border-radius:20px; }
        .role-admin { background:rgba(239,68,68,0.2); color:#fca5a5; border:1px solid rgba(239,68,68,0.3); }
        .role-customer { background:rgba(16,185,129,0.2); color:#6ee7b7; border:1px solid rgba(16,185,129,0.3); }
        .empty-state { text-align:center; padding:40px; color:rgba(255,255,255,0.35); font-size:14px; }
    </style>
</head>
<body>
    <nav>
        <a class="brand">
            <div class="brand-dot"><i class="bi bi-basket2-fill"></i></div>
            Laundry Express
        </a>
        <span class="nav-badge">Admin Panel</span>
    </nav>
    <div class="container">
        <div class="page-head">
            <div>
                <h2>Customer List</h2>
                <p>All registered users and admins</p>
            </div>
            <a asp-action="AdminDashboard" class="back-btn"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
        <div class="glass-card">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td style="color:rgba(255,255,255,0.4);">@serial</td>
                                <td>
                                    <div class="name-cell">
                                        <span class="avatar">@(c.Name?.Length > 0 ? c.Name[0].ToString().ToUpper() : "?")</span>
                                        <span style="font-weight:500;">@c.Name</span>
                                    </div>
                                </td>
                                <td style="color:rgba(165,180,252,0.85);">@c.Email</td>
                                <td>
                                    @if (c.role == "Admin") { <span class="role-pill role-admin">Admin</span> }
                                    else { <span class="role-pill role-customer">Customer</span> }
                                </td>
                            </tr>
                            serial++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="4"><div class="empty-state"><i class="bi bi-people" style="font-size:32px;display:block;margin-bottom:8px;"></i>No customers found</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>