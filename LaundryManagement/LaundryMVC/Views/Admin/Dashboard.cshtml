<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <style>
        :root {
            --shadow-card: 0 12px 40px rgba(30,120,200,0.15), 0 2px 8px rgba(30,120,200,0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .dash {
            background: linear-gradient(135deg, #d0edff 0%, #e8f7ff 40%, #b8dff5 100%);
            min-height: 100vh;
            display: flex;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 210px;
            flex-shrink: 0;
            background: linear-gradient(180deg, rgba(255,255,255,0.75) 0%, rgba(190,225,250,0.65) 100%);
            border-right: 1.5px solid rgba(255,255,255,0.72);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            box-shadow: 4px 0 24px rgba(60,150,220,0.10);
            display: flex;
            flex-direction: column;
            padding: 28px 0 20px;
        }

        .logo {
            font-size: 19px;
            font-weight: 700;
            letter-spacing: -0.5px;
            padding: 0 22px 22px;
            color: #0e5fa8;
            border-bottom: 1px solid rgba(100,180,240,0.22);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #5bc4f8 0%, #1a7bbf 100%);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(26,123,191,0.35), inset 0 1px 2px rgba(255,255,255,0.5);
            font-size: 17px;
            color: white;
            flex-shrink: 0;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 22px;
            font-size: 13px;
            font-weight: 400;
            color: #4a7fa8;
            cursor: pointer;
            border-left: 2.5px solid transparent;
            transition: all 0.17s;
            text-decoration: none;
        }

            .nav-item:hover {
                background: rgba(100,190,240,0.13);
                color: #0e5fa8;
            }

            .nav-item.active {
                background: linear-gradient(90deg, rgba(90,180,250,0.22) 0%, rgba(90,180,250,0.04) 100%);
                border-left-color: #1a9af5;
                color: #0a6fc7;
                font-weight: 600;
            }

        .nav-icon {
            font-size: 15px;
            flex-shrink: 0;
        }

        .nav-spacer {
            flex: 1;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 22px;
            font-size: 13px;
            color: #d44;
            cursor: pointer;
            border: none;
            background: none;
            font-family: inherit;
            width: 100%;
            border-left: 2.5px solid transparent;
            transition: all 0.17s;
            text-decoration: none;
        }

            .logout-btn:hover {
                background: rgba(220,60,60,0.07);
            }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: 30px 28px;
            overflow-y: auto;
        }

        .topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 26px;
        }

        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #0a4f8c;
            letter-spacing: -0.3px;
        }

        .page-sub {
            font-size: 12.5px;
            color: #6aaccc;
            margin-top: 2px;
        }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            color: #0ea67a;
            background: rgba(255,255,255,0.7);
            border: 1px solid rgba(14,166,122,0.28);
            border-radius: 100px;
            padding: 6px 14px;
            backdrop-filter: blur(8px);
            box-shadow: 0 2px 8px rgba(14,166,122,0.10);
        }

        .live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #0ea67a;
            box-shadow: 0 0 0 3px rgba(14,166,122,0.2);
            animation: blink 2s infinite;
        }
        .keyframes blink {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: 0.35
            }
        }

        /* ── STAT CARDS ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0,1fr));
            gap: 14px;
            margin-bottom: 22px;
        }

        .stat-card {
            background: linear-gradient(145deg, rgba(255,255,255,0.82) 0%, rgba(210,240,255,0.72) 100%);
            border: 1.5px solid rgba(255,255,255,0.78);
            border-radius: 18px;
            padding: 20px 18px 16px;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-card), inset 0 1.5px 3px rgba(255,255,255,0.7);
            transition: transform 0.18s, box-shadow 0.18s;
        }

            .stat-card:hover {
                transform: translateY(-3px) scale(1.012);
                box-shadow: 0 18px 50px rgba(30,120,200,0.20), 0 4px 12px rgba(30,120,200,0.12), inset 0 1.5px 3px rgba(255,255,255,0.7);
            }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                border-radius: 18px 18px 0 0;
            }

        .card-blue::before {
            background: linear-gradient(90deg, #4fc4f8, #1a7bbf);
        }

        .card-teal::before {
            background: linear-gradient(90deg, #1dcfa8, #0ea67a);
        }

        .card-amber::before {
            background: linear-gradient(90deg, #f8c94f, #e8a020);
        }

        .card-sky::before {
            background: linear-gradient(90deg, #5bc4f8, #3498db);
        }

        .stat-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            margin-bottom: 12px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.10), inset 0 1px 2px rgba(255,255,255,0.6);
        }

        .ic-blue {
            background: linear-gradient(135deg, #b8e4ff, #7ec8f7);
        }

        .ic-teal {
            background: linear-gradient(135deg, #b2f0e0, #5dd9b4);
        }

        .ic-amber {
            background: linear-gradient(135deg, #fce8b2, #f8c94f);
        }

        .ic-sky {
            background: linear-gradient(135deg, #c2e8ff, #7ec8f7);
        }

        .stat-label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #6aaccc;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #0a4f8c;
            line-height: 1;
            margin-bottom: 10px;
            letter-spacing: -1px;
        }

        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 10.5px;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: 20px;
        }

        .pill-blue {
            background: rgba(26,123,191,0.12);
            color: #1a7bbf;
        }

        .pill-green {
            background: rgba(14,166,122,0.12);
            color: #0a8f6a;
        }

        .pill-amber {
            background: rgba(232,160,32,0.14);
            color: #b87c00;
        }

        .pill-sky {
            background: rgba(52,152,219,0.12);
            color: #2375a8;
        }

        /* ── BOTTOM GRID ── */
        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 14px;
        }

        .glass-card {
            background: linear-gradient(145deg, rgba(255,255,255,0.78) 0%, rgba(210,240,255,0.65) 100%);
            border: 1.5px solid rgba(255,255,255,0.74);
            border-radius: 18px;
            padding: 22px 22px 18px;
            box-shadow: var(--shadow-card), inset 0 1.5px 3px rgba(255,255,255,0.65);
        }

        .card-hdr {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .card-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #0a4f8c;
        }

        .card-tag {
            font-size: 11px;
            color: #7abbd8;
            background: rgba(100,190,240,0.13);
            border: 1px solid rgba(100,190,240,0.22);
            padding: 3px 10px;
            border-radius: 8px;
        }

        /* ── CHART ── */
        .chart-wrap {
            height: 140px;
            display: flex;
            align-items: flex-end;
            gap: 7px;
        }

        .bar-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }

        .bar-group {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            width: 100%;
        }

        .bar {
            flex: 1;
            border-radius: 5px 5px 0 0;
            transition: opacity 0.18s;
            cursor: pointer;
            box-shadow: inset 0 2px 4px rgba(255,255,255,0.45), 0 3px 8px rgba(30,120,200,0.15);
        }

            .bar:hover {
                opacity: 0.78;
            }

        .bar-label {
            font-size: 10px;
            color: #8ac4de;
        }

        .legend {
            display: flex;
            gap: 14px;
            margin-top: 12px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            color: #6aaccc;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 4px;
        }

        /* ── QUICK ACTIONS ── */
        .actions-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 13px;
            border: 1.5px solid rgba(255,255,255,0.7);
            background: linear-gradient(135deg, rgba(255,255,255,0.72) 0%, rgba(210,240,255,0.55) 100%);
            color: #2a6fa8;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.18s;
            text-align: left;
            width: 100%;
            text-decoration: none;
            box-shadow: 0 3px 10px rgba(30,120,200,0.09), inset 0 1px 2px rgba(255,255,255,0.65);
        }

            .action-btn:hover {
                background: linear-gradient(135deg, rgba(26,154,245,0.14) 0%, rgba(90,190,250,0.08) 100%);
                border-color: rgba(26,154,245,0.45);
                color: #0a5fa8;
                transform: translateX(2px);
                box-shadow: 0 5px 18px rgba(30,120,200,0.15), inset 0 1px 2px rgba(255,255,255,0.65);
            }

        .ab-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08), inset 0 1px 2px rgba(255,255,255,0.6);
        }

        .ab-blue {
            background: linear-gradient(135deg, #b8e4ff, #7ec8f7);
        }

        .ab-teal {
            background: linear-gradient(135deg, #b2f0e0, #5dd9b4);
        }

        .ab-amber {
            background: linear-gradient(135deg, #fce8b2, #f8c94f);
        }

        .ab-arrow {
            margin-left: auto;
            color: #a0c8e0;
            font-size: 13px;
            transition: color 0.18s;
        }

        .action-btn:hover .ab-arrow {
            color: #1a7bbf;
        }

        .divider {
            height: 1px;
            background: rgba(100,190,240,0.18);
            margin: 2px 0;
        }
    </style>
</head>
<body>
    <div class="dash">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="logo">
                <div class="logo-icon">🧺</div>
                Laundry<span style="color:#60bef5">.</span>
            </div>

            <a class="nav-item active" asp-action="Index" asp-controller="Admin">
                <span class="nav-icon">⊞</span> Dashboard
            </a>
            <a class="nav-item" asp-action="Customers" asp-controller="Admin">
                <span class="nav-icon">👥</span> Customers
            </a>
            <a class="nav-item" asp-action="Orders" asp-controller="Admin">
                <span class="nav-icon">📋</span> Orders
            </a>
            <a class="nav-item" asp-action="Items" asp-controller="Admin">
                <span class="nav-icon">🧺</span> Manage Items
            </a>
            <div class="nav-spacer"></div>
            <a class="logout-btn" asp-action="Logout" asp-controller="Admin">
                <span class="nav-icon">⏻</span> Logout
            </a>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="topbar">
                <div>
                    <div class="page-title">Overview</div>
                    <div class="page-sub">Welcome back, Admin</div>
                </div>
                <div class="live-badge">
                    <span class="live-dot"></span> Live data
                </div>
            </div>

            <!-- STAT CARDS -->
            <div class="stats-grid">
                <div class="stat-card card-blue">
                    <div class="stat-icon ic-blue">📦</div>
                    <div class="stat-label">Total Orders</div>
                    <div class="stat-value">@ViewBag.TotalOrders</div>
                    <span class="stat-pill pill-blue">All time</span>
                </div>
                <div class="stat-card card-teal">
                    <div class="stat-icon ic-teal">👥</div>
                    <div class="stat-label">Total Customers</div>
                    <div class="stat-value">@ViewBag.TotalCustomers</div>
                    <span class="stat-pill pill-green">↑ Growing</span>
                </div>
                <div class="stat-card card-amber">
                    <div class="stat-icon ic-amber">⏳</div>
                    <div class="stat-label">Pending Orders</div>
                    <div class="stat-value">@ViewBag.Pending</div>
                    <span class="stat-pill pill-amber">Needs review</span>
                </div>
                <div class="stat-card card-sky">
                    <div class="stat-icon ic-sky">✅</div>
                    <div class="stat-label">Completed Orders</div>
                    <div class="stat-value">@ViewBag.Completed</div>
                    <span class="stat-pill pill-sky">Fulfilled</span>
                </div>
            </div>

            <!-- BOTTOM GRID -->
            <div class="bottom-grid">

                <div class="glass-card">
                    <div class="card-hdr">
                        <div class="card-title">Order activity</div>
                        <span class="card-tag">Last 7 days</span>
                    </div>
                    <div class="chart-wrap" id="chart"></div>
                    <div class="legend">
                        <div class="legend-item">
                            <span class="legend-dot" style="background:linear-gradient(135deg,#5bc4f8,#1a7bbf);"></span> Completed
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot" style="background:linear-gradient(135deg,#c2e8ff,#90d0f5);"></span> Pending
                        </div>
                    </div>
                </div>

                <div class="glass-card">
                    <div class="card-hdr">
                        <div class="card-title">Quick actions</div>
                    </div>
                    <div class="actions-list">
                        <a class="action-btn" asp-action="Customers" asp-controller="Admin">
                            <span class="ab-icon ab-teal">👥</span> View Customers
                            <span class="ab-arrow">→</span>
                        </a>
                        <a class="action-btn" asp-action="Orders" asp-controller="Admin">
                            <span class="ab-icon ab-blue">📋</span> View Orders
                            <span class="ab-arrow">→</span>
                        </a>
                        <div class="divider"></div>
                        <a class="action-btn" asp-action="Items" asp-controller="Admin">
                            <span class="ab-icon ab-amber">🧺</span> Manage Items
                            <span class="ab-arrow">→</span>
                        </a>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        const days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
        const completed = [14,22,18,30,26,38,20];
        const pending   = [6,8,5,10,7,12,9];
        const maxVal = Math.max(...completed, ...pending) + 4;
        const chart = document.getElementById('chart');

        days.forEach((d, i) => {
            const col = document.createElement('div');
            col.className = 'bar-col';
            const cH = Math.round((completed[i] / maxVal) * 130);
            const pH = Math.round((pending[i] / maxVal) * 130);
            col.innerHTML = `
                <div class="bar-group" style="height:130px;">
                    <div class="bar" style="height:${cH}px;background:linear-gradient(180deg,#5bc4f8,#1a7bbf);"></div>
                    <div class="bar" style="height:${pH}px;background:linear-gradient(180deg,#c2e8ff,#90d0f5);"></div>
                </div>
                <span class="bar-label">${d}</span>`;
            chart.appendChild(col);
        });
    </script>
</body>
</html>